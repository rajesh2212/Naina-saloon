# ---------------------------------------------------------------------------
# Naina Beauty Parlour — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every value below is a placeholder; nothing here is a working credential.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Public origin of this site. Used to build password-reset links, so it must
# match the address users actually open in their browser.
PUBLIC_APP_URL=http://127.0.0.1:3000

# --- Database ---------------------------------------------------------------
# SQLite file used for users, services, hours, slots and bookings.
# The directory is created automatically by `npm run db:setup`.
DATABASE_FILE=./data/naina.db

# --- Sessions ---------------------------------------------------------------
# REQUIRED. Long random string used to sign session cookies.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-secret
# Set to 1 only when the site is served over HTTPS; cookies then become Secure.
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy (nginx, Cloudflare, PM2, etc.)
TRUST_PROXY=0

# --- CAPTCHA ----------------------------------------------------------------
# CAPTCHA is always verified on the server. Two providers are supported:
#
# 1. Cloudflare Turnstile (recommended for production).
#    Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
#    Leave both blank to disable Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
#
# 2. Built-in image CAPTCHA (svg-captcha) — used automatically when Turnstile
#    is not configured. Needs no credentials and still verifies server-side.
#    Optional hardening: require the answer to be re-entered after 2 failures.
CAPTCHA_MAX_ATTEMPTS=3

# --- Email (password reset) -------------------------------------------------
# REQUIRED for the forgot-password flow. Without SMTP settings the reset flow
# reports that email delivery is unavailable and sends nothing (it never
# pretends a mail was delivered).
SMTP_HOST=
SMTP_PORT=587
# 1 = implicit TLS (port 465), 0 = STARTTLS (port 587)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Naina Beauty Parlour <no-reply@example.com>"
# Where the studio receives contact/booking copies, if you want them.
SALON_NOTIFY_EMAIL=

# Local development only: when SMTP_HOST is empty, set this to `file` and reset
# emails are written to ./data/outbox/*.eml so the flow can be tested without a
# mail server. Must stay `off` in production.
MAIL_DEV_OUTBOX=off

# --- Salon details (display + booking rules) -------------------------------
SALON_NAME="Naina Beauty Parlour"
SALON_TAGLINE="Salon Make-up Studio"
SALON_PHONE=094397 12994
SALON_ADDRESS="College Road, near Lucky Mess, Bagurai, Jagannathpur, Bhadrak, Odisha 756100, India"
SALON_SINCE=2018
SALON_MAPS_URL="https://www.google.com/maps/place/Naina+Beauty+Parlour/@21.0637569,86.4933537,20.97z/data=!4m6!3m5!1s0x3a1bf7f91d33f1ff:0x9874be5037c89943!8m2!3d21.0637734!4d86.4936311!16s%2Fg%2F11fk4qz5qb"

# The IANA zone the studio's diary is written on. Every appointment time, opening
# hour and slot is a wall-clock value on THIS clock, so it decides what "10:30"
# means. A zone saved in the staff portal (/portal/settings) overrides this.
SALON_TIMEZONE=Asia/Kolkata

# --- First staff/admin account ---------------------------------------------
# Optional. Preferred way is `npm run create-admin` (interactive).
# Do NOT reuse a real customer password; change it after first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
