# ---------------------------------------------------------------------------
# Naina Beauty Parlour — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every value below is a placeholder; nothing here is a working credential.
#
# Staff can change the studio's own words from /portal/details, and its opening
# hours, booking rules, time zone and staff logins from the portal too. What is
# NOT on any portal form, on purpose: SESSION_SECRET, the SMTP credentials,
# TURNSTILE_SECRET_KEY, PUBLIC_APP_URL and DATABASE_URL. Those are secrets and
# deployment facts — putting them in a browser-editable field would mean sending
# the cookie-signing key and the mailbox password over the very site they protect.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Public origin of this site. Used to build password-reset links, so it must
# match the address users actually open in their browser.
PUBLIC_APP_URL=http://127.0.0.1:3000

# --- Database ---------------------------------------------------------------
# Postgres holds users, services, hours, slots, bookings and sessions. It is
# REQUIRED: the app no longer keeps anything on the local disk, because a hosted
# web process gets a fresh, read-only filesystem on every request.
#
# Use the POOLED connection string (Neon: …pooler…; Vercel Postgres: the
# POSTGRES_URL it injects). A pooled URL is what keeps a burst of bookings from
# exhausting the database's connection limit.
#
# This value carries the database password. Nothing in the app prints it — the
# boot banner, the logs and `npm run check` show only host + database name.
DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Sessions ---------------------------------------------------------------
# REQUIRED. Long random string used to sign session cookies.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-secret
# Set to 1 only when the site is served over HTTPS; cookies then become Secure.
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy (nginx, Cloudflare, PM2, etc.)
TRUST_PROXY=0

# --- CAPTCHA ----------------------------------------------------------------
# CAPTCHA is always verified on the server. Two providers are supported:
#
# 1. Cloudflare Turnstile (recommended for production).
#    Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
#    Leave both blank to disable Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
#
# 2. Built-in image CAPTCHA (svg-captcha) — used automatically when Turnstile
#    is not configured. Needs no credentials and still verifies server-side.
#    Optional hardening: require the answer to be re-entered after 2 failures.
CAPTCHA_MAX_ATTEMPTS=3

# --- Email (password reset) -------------------------------------------------
# REQUIRED for the forgot-password flow. Without SMTP settings the reset flow
# reports that email delivery is unavailable and sends nothing (it never
# pretends a mail was delivered).
SMTP_HOST=
SMTP_PORT=587
# 1 = implicit TLS (port 465), 0 = STARTTLS (port 587)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Naina Beauty Parlour <no-reply@example.com>"
# Where the studio receives contact/booking copies, if you want them.
SALON_NOTIFY_EMAIL=

# Local development only: when SMTP_HOST is empty, set this to `file` and reset
# emails are written to ./data/outbox/*.eml so the flow can be tested without a
# mail server. Must stay `off` in production.
MAIL_DEV_OUTBOX=off

# --- Salon details (display + booking rules) -------------------------------
# These are the studio's own words, and they are a STARTING POINT: staff can edit
# every one of them at /portal/details, and a value saved there wins over what is
# below until the box on that page is emptied again.
SALON_NAME="Naina Beauty Parlour"
SALON_TAGLINE="Salon Make-up Studio"
SALON_PHONE=094397 12994
SALON_ADDRESS="College Road, near Lucky Mess, Bagurai, Jagannathpur, Bhadrak, Odisha 756100, India"
SALON_SINCE=2018
SALON_MAPS_URL="https://www.google.com/maps/place/Naina+Beauty+Parlour/@21.0637569,86.4933537,20.97z/data=!4m6!3m5!1s0x3a1bf7f91d33f1ff:0x9874be5037c89943!8m2!3d21.0637734!4d86.4936311!16s%2Fg%2F11fk4qz5qb"

# The IANA zone the studio's diary is written on. Every appointment time, opening
# hour and slot is a wall-clock value on THIS clock, so it decides what "10:30"
# means. A zone saved in the staff portal (/portal/settings) overrides this.
SALON_TIMEZONE=Asia/Kolkata

# --- Files the app writes ---------------------------------------------------
# Each confirmed booking's PDF ticket goes to ./uploads/tickets and every
# customer avatar to ./uploads/avatars. The directory is created on first use, so
# a clone needs no storage service and no setup step — the only requirement is
# that the process user can write to it.
#
# These files are NOT under /public, and that is deliberate. /public is what the
# static mount serves to anybody who asks, and a ticket is simply named
# booking-<id>.pdf, so a folder inside it would hand out strangers' names, phone
# numbers and faces to anyone who guessed a number. Tickets are streamed through
# the sign-in-guarded /account/ticket/<id>, and an avatar is served by a route
# that only ever opens the one file the signed-in account owns.
#
# Optional, and only for hosts where ./uploads is not persistent storage — for
# example a container with a mounted volume. Must be an absolute path or one
# relative to the project root.
# UPLOADS_DIR=/data/uploads

# --- First staff/admin account ---------------------------------------------
# Only the FIRST staff login needs the terminal. Everyone after that is added by
# a signed-in staff member at /portal/staff — no shell access, no restart.
# Optional. Preferred way is `npm run create-admin` (interactive).
# Do NOT reuse a real customer password; change it after first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
