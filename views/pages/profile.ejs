<%- include('../partials/head') %>

<%
  var errs = locals.errors || {};
  var vals = locals.values || {};
  var user = locals.user || currentUser;
  var completion = locals.completion || { percent: 0, complete: false, steps: [], missing: [] };
  var blocks = locals.blocks || [];
  var addressMax = locals.addressMax || 300;
  var showPasswordErrors = Boolean(errs.password || errs.current || errs.confirm || errs.captcha);
  var initials = String(vals.name || user.name || '').trim().split(/\s+/).slice(0, 2).map(function (w) { return w.charAt(0); }).join('').toUpperCase();
  var photo = user.photo_path || null;
%>

<section class="section" aria-labelledby="page-title">
  <div class="wrap wrap--narrow">
    <p class="eyebrow">Account</p>
    <h1 id="page-title">My details</h1>

    <div class="profile-id">
      <div class="avatar">
        <% if (photo) { %>
          <img class="avatar__img" src="<%= photo %>" alt="Your profile photo" width="72" height="72">
        <% } else { %>
          <span class="avatar__img avatar__img--empty" aria-hidden="true"><%= initials || '&amp;' %></span>
        <% } %>
        <% if (completion.complete) { %>
          <span class="profile-tick" title="Profile complete">
            <svg class="profile-tick__icon" width="16" height="16" viewBox="0 0 24 24" role="img" aria-label="Profile complete" focusable="false">
              <path d="M4 13l5 5L20 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        <% } %>
      </div>
      <div class="profile-id__text">
        <p class="profile-id__name"><%= vals.name || user.name %></p>
        <p class="muted small">
          <%= user.email %>
          <% if (user.phone) { %> &middot; <%= user.phone %><% } %>
        </p>
        <% if (completion.complete) { %>
          <p class="profile-id__note">
            Your profile is complete, so you can ask the studio for a chair time.
            <span class="muted">The blue tick only means “the studio has everything it needs” — it is not an identity check.</span>
          </p>
        <% } %>
      </div>
    </div>

    <% if (!completion.complete) { %>
      <div class="meter" role="group" aria-labelledby="meter-title">
        <div class="meter__head">
          <p id="meter-title" class="meter__title">Profile complete</p>
          <p class="meter__percent" aria-live="polite"><%= completion.percent %>%</p>
        </div>
        <div class="meter__track" role="progressbar" aria-valuemin="0" aria-valuemax="100"
             aria-valuenow="<%= completion.percent %>" aria-labelledby="meter-title" aria-live="polite">
          <% completion.steps.forEach(function (step) { %>
            <span class="meter__seg<%= step.done ? ' is-done' : '' %>"></span>
          <% }); %>
        </div>
        <ul class="meter__steps">
          <% completion.steps.forEach(function (step) { %>
            <li class="meter__step<%= step.done ? ' is-done' : '' %>">
              <span class="meter__dot" aria-hidden="true"></span>
              <%= step.label %>
            </li>
          <% }); %>
        </ul>
        <p class="hint">
          The bar moves the moment you save. The studio asks for these six things and nothing else —
          no gender, no payment details.
        </p>
      </div>
    <% } %>

    <p class="lede">
      These are the details the studio sees when you book. Nothing here asks for your gender, and no
      payment information is collected.
    </p>
  </div>
</section>

<section class="section section--panel" aria-labelledby="details-title">
  <div class="wrap wrap--narrow">
    <h2 id="details-title">Contact details</h2>
    <form method="post" action="/account/profile" class="mt-1" enctype="application/x-www-form-urlencoded">
      <%- csrfField() %>

      <div class="field">
        <label for="name">Name</label>
        <input class="input" id="name" name="name" type="text" autocomplete="name" required maxlength="80"
               value="<%= vals.name %>"
               aria-describedby="name-hint<%= errs.name ? ' name-error' : '' %>"
               <% if (errs.name) { %>aria-invalid="true"<% } %>>
        <% if (errs.name) { %><p class="error" id="name-error"><%= errs.name %></p><% } %>
        <p class="hint" id="name-hint">How the studio greets you and writes the diary entry.</p>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input class="input" id="email" type="email" value="<%= user.email %>" disabled aria-describedby="email-hint">
        <p class="hint" id="email-hint">
          Your sign-in address cannot be edited here — it is tied to the reset links. <a href="/auth/register">Register a new account</a>
          if you have moved to a different address.
        </p>
      </div>

      <div class="field">
        <label for="phone">Mobile number</label>
        <input class="input" id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel"
               maxlength="20" value="<%= vals.phone %>"
               aria-describedby="phone-hint<%= errs.phone ? ' phone-error' : '' %>"
               <% if (errs.phone) { %>aria-invalid="true"<% } %>>
        <% if (errs.phone) { %><p class="error" id="phone-error"><%= errs.phone %></p><% } %>
        <p class="hint" id="phone-hint">Pre-filled on each booking so the counter can reach you.</p>
      </div>

      <div class="field">
        <label for="age">Age</label>
        <input class="input input--narrow" id="age" name="age" type="text" inputmode="numeric"
               autocomplete="off" maxlength="3" value="<%= vals.age %>"
               aria-describedby="age-hint<%= errs.age ? ' age-error' : '' %>"
               <% if (errs.age) { %>aria-invalid="true"<% } %>>
        <% if (errs.age) { %><p class="error" id="age-error"><%= errs.age %></p><% } %>
        <p class="hint" id="age-hint">Whole years. The studio uses it to choose the right products.</p>
      </div>

      <div class="field">
        <label for="address">Address</label>
        <textarea class="textarea textarea--short" id="address" name="address" rows="3"
                  maxlength="<%= addressMax %>"
                  aria-describedby="address-hint<%= errs.address ? ' address-error' : '' %>"
                  <% if (errs.address) { %>aria-invalid="true"<% } %>><%= vals.address %></textarea>
        <% if (errs.address) { %><p class="error" id="address-error"><%= errs.address %></p><% } %>
        <p class="hint" id="address-hint">Write it yourself, however you would give it to the counter — house or street, landmark, pin code.</p>
      </div>

      <div class="field">
        <label for="block">Block you live in</label>
        <select class="select" id="block" name="block"
                aria-describedby="block-hint<%= errs.block ? ' block-error' : '' %>"
                <% if (errs.block) { %>aria-invalid="true"<% } %>>
          <option value="">Choose your Block&hellip;</option>
          <% blocks.forEach(function (block) { %>
            <option value="<%= block %>"<%= vals.block === block ? ' selected' : '' %>><%= block %></option>
          <% }); %>
        </select>
        <% if (errs.block) { %><p class="error" id="block-error"><%= errs.block %></p><% } %>
        <p class="hint" id="block-hint">One of the seven Blocks around Bhadrak that the studio serves.</p>
      </div>

      <div class="field">
        <label for="preferred_title">Called as <span class="optional">(optional)</span></label>
        <input class="input" id="preferred_title" name="preferred_title" type="text" maxlength="24"
               autocomplete="nickname" placeholder="Ms., Mr., Mx., or leave blank" value="<%= vals.preferredTitle %>">
      </div>

      <div class="field">
        <label for="notes">Standing notes for the studio <span class="optional">(optional)</span></label>
        <textarea class="textarea" id="notes" name="notes" rows="3" maxlength="500"><%= vals.notes %></textarea>
        <p class="hint">Anything useful every time — hair length, shade you use, which family you usually book with.</p>
      </div>

      <h2 class="field-group-title" id="photo-title">Profile photo</h2>
      <div class="field photo-picker">
        <label for="photo_file">Add a picture to sit beside your name</label>
        <input class="input" id="photo_file" type="file" accept="image/jpeg,image/png,image/webp"
               data-photo-input aria-describedby="photo-hint photo-preview-state<%= errs.photo ? ' photo-error' : '' %>"
               <% if (errs.photo) { %>aria-invalid="true"<% } %>>
        <input type="hidden" name="photo_data" data-photo-data>
        <img class="photo-preview" data-photo-preview alt="Preview of the new profile photo" hidden>
        <% if (errs.photo) { %><p class="error" id="photo-error"><%= errs.photo %></p><% } %>
        <p class="hint" id="photo-hint">
          Cropped to a square and shrunk by your browser before it is sent, so nothing large leaves this
          device. JPEG, PNG or WebP.
        </p>
        <p class="photo-state" id="photo-preview-state" data-photo-state<%= photo ? '' : ' hidden' %>>
          <%= photo ? 'A photo is saved on your profile.' : 'No photo yet.' %>
        </p>
        <% if (photo) { %>
          <label class="checkline">
            <input type="checkbox" name="remove_photo" value="1" data-photo-remove>
            Remove the current photo
          </label>
        <% } %>
        <noscript>
          <p class="form-note">
            Choosing a picture needs JavaScript, because the crop happens in your browser. Without it the
            other details still save — ask at the counter and the team can note a photo for you.
          </p>
        </noscript>
      </div>

      <div class="form-actions">
        <button class="btn btn--primary" type="submit">Save details</button>
        <a class="btn btn--ghost" href="/account">Back to my bookings</a>
      </div>
      <% if (!completion.complete) { %>
        <p class="form-note">
          Saving a part-filled profile is fine — the bar above shows what is left, and the studio needs all
          of it before it will hold a chair time.
        </p>
      <% } %>
    </form>
  </div>
</section>

<section class="section" aria-labelledby="password-title">
  <div class="wrap wrap--narrow">
    <h2 id="password-title">Change password</h2>
    <p class="muted">
      Passwords are stored only as bcrypt hashes. Signing out is not needed after changing it, but other
      devices will have to sign in again.
    </p>

    <% if (errs.form) { %><p class="alert alert--error" role="alert"><%= errs.form %></p><% } %>

    <form method="post" action="/account/password" class="mt-1">
      <%- csrfField() %>

      <%- include('../partials/password-field', {
        id: 'current_password',
        label: 'Current password',
        autocomplete: 'current-password',
        error: errs.current || null
      }) %>

      <%- include('../partials/password-field', {
        id: 'password',
        label: 'New password',
        autocomplete: 'new-password',
        minLength: 10,
        error: errs.password || null,
        hint: 'At least 10 characters, with a letter and a number.'
      }) %>

      <%- include('../partials/password-field', {
        id: 'confirm_password',
        name: 'confirm_password',
        label: 'Repeat the new password',
        autocomplete: 'new-password',
        error: errs.confirm || null
      }) %>

      <%- include('../partials/captcha') %>

      <div class="form-actions">
        <button class="btn" type="submit">Update password</button>
      </div>
      <% if (showPasswordErrors && !site.captcha.turnstileConfigured) { %>
        <p class="form-note">A fresh verification image was loaded — type the new characters.</p>
      <% } %>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
