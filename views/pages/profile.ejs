<%- include('../partials/head') %>

<%
  var errs = locals.errors || {};
  var vals = locals.values || {};
  var user = locals.user || currentUser;
  var completion = locals.completion || { percent: 0, complete: false, steps: [], missing: [] };
  var blocks = locals.blocks || [];
  var addressMax = locals.addressMax || 300;
  var showPasswordErrors = Boolean(errs.password || errs.current || errs.confirm || errs.captcha);
  var initials = String(vals.name || user.name || '').trim().split(/\s+/).slice(0, 2).map(function (w) { return w.charAt(0); }).join('').toUpperCase();
  var photo = user.photo_path || null;
%>

<section class="section section--flower" aria-labelledby="page-title">
  <%- include('../partials/flower', { pos: 'tr' }) %>
  <div class="wrap wrap--narrow">
    <p class="eyebrow">Account</p>
    <h1 id="page-title">My details</h1>

    <div class="profile-id">
      <div class="avatar">
        <% if (photo) { %>
          <img class="avatar__img" src="<%= photo %>" alt="Your profile photo" width="72" height="72">
        <% } else { %>
          <span class="avatar__img avatar__img--empty" aria-hidden="true"><%= initials || '&amp;' %></span>
        <% } %>
        <% if (completion.complete) { %>
          <span class="profile-tick" title="Profile complete">
            <svg class="profile-tick__icon" width="16" height="16" viewBox="0 0 24 24" role="img" aria-label="Profile complete" focusable="false">
              <path d="M4 13l5 5L20 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        <% } %>
      </div>
      <div class="profile-id__text">
        <p class="profile-id__name"><%= vals.name || user.name %></p>
        <p class="muted small">
          <%= user.email %>
          <% if (user.phone) { %> &middot; <%= user.phone %><% } %>
        </p>
        <% if (completion.complete) { %>
          <p class="profile-id__note">
            Your profile is complete, so you can ask the studio for a chair time.
            <span class="muted">The blue tick only means “the studio has everything it needs” — it is not an identity check.</span>
          </p>
        <% } %>
      </div>
    </div>

    <% if (!completion.complete) { %>
      <div class="meter" role="group" aria-labelledby="meter-title">
        <div class="meter__head">
          <p id="meter-title" class="meter__title">Profile complete</p>
          <p class="meter__percent" aria-live="polite"><%= completion.percent %>%</p>
        </div>
        <div class="meter__track" role="progressbar" aria-valuemin="0" aria-valuemax="100"
             aria-valuenow="<%= completion.percent %>" aria-labelledby="meter-title" aria-live="polite">
          <% completion.steps.forEach(function (step) { %>
            <span class="meter__seg<%= step.done ? ' is-done' : '' %>"></span>
          <% }); %>
        </div>
        <ul class="meter__steps">
          <% completion.steps.forEach(function (step) { %>
            <li class="meter__step<%= step.done ? ' is-done' : '' %>">
              <span class="meter__dot" aria-hidden="true"></span>
              <%= step.label %>
            </li>
          <% }); %>
        </ul>
        <p class="hint">
          The bar moves the moment you save. The studio asks for these six things and nothing else —
          no gender, no payment details.
        </p>
      </div>
    <% } %>

    <p class="lede">
      These are the details the studio sees when you book. Nothing here asks for your gender, and no
      payment information is collected.
    </p>
  </div>
</section>

<section class="section section--panel" aria-labelledby="details-title">
  <div class="wrap wrap--narrow">
    <h2 id="details-title">Contact details</h2>
    <%- include('../partials/profile-fields', {
      errors: errs,
      values: vals,
      user: user,
      blocks: blocks,
      completion: completion,
      addressMax: addressMax,
      idPrefix: '',
      inPanel: false,
      photoOnly: false
    }) %>
  </div>
</section>

<section class="section" aria-labelledby="password-title">
  <div class="wrap wrap--narrow">
    <h2 id="password-title">Change password</h2>
    <p class="muted">
      Passwords are stored only as bcrypt hashes. Signing out is not needed after changing it, but other
      devices will have to sign in again.
    </p>

    <% if (errs.form) { %><p class="alert alert--error" role="alert"><%= errs.form %></p><% } %>

    <form method="post" action="/account/password" class="mt-1">
      <%- csrfField() %>

      <%- include('../partials/password-field', {
        id: 'current_password',
        label: 'Current password',
        autocomplete: 'current-password',
        error: errs.current || null
      }) %>

      <%- include('../partials/password-field', {
        id: 'password',
        label: 'New password',
        autocomplete: 'new-password',
        minLength: 10,
        error: errs.password || null,
        hint: 'At least 10 characters, with a letter and a number.'
      }) %>

      <%- include('../partials/password-field', {
        id: 'confirm_password',
        name: 'confirm_password',
        label: 'Repeat the new password',
        autocomplete: 'new-password',
        error: errs.confirm || null
      }) %>

      <%- include('../partials/captcha') %>

      <div class="form-actions">
        <button class="btn" type="submit">Update password</button>
      </div>
      <% if (showPasswordErrors && !site.captcha.turnstileConfigured) { %>
        <p class="form-note">A fresh verification image was loaded — type the new characters.</p>
      <% } %>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
