<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · <%= salon.name %></title>
    <meta name="description" content="<%= salon.name %> — <%= salon.tagline %> in Jagannathpur, Bhadrak, Odisha. Bridal and occasion makeup, hair, skin and beauty services since <%= salon.since %>. Book an appointment online.">
    <meta name="theme-color" content="#fdf8f4">
    <meta name="color-scheme" content="light">
    <link rel="icon" href="/favicon.svg">
    <link rel="stylesheet" href="/styles.css?v=<%= assets.version %>">
    <script src="/main.js" defer></script>
  </head>
  <body class="minimal-page">
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <% var path = currentPath || '/'; %>
        <nav class="nav" id="primary-nav" data-nav data-open="false" aria-label="Main">
          <ul class="nav__list">
            <%# aria-current is emitted with a plain scriptlet. Inside an interpolating tag the quotes
                would come out as HTML entities, and both the CSS match and the screen-reader
                announcement need the bare value. (Never write a tag example in here: the comment ends
                at the first closing delimiter it sees.) %>
            <li><a class="nav__link" href="/services"<% if (path.indexOf('/services') === 0) { %> aria-current="page"<% } %>>Services</a></li>
            <li><a class="nav__link" href="/studio"<% if (path === '/studio') { %> aria-current="page"<% } %>>The studio</a></li>
            <li><a class="nav__link" href="/how-to-book"<% if (path === '/how-to-book') { %> aria-current="page"<% } %>>Your visit</a></li>
            <li><a class="nav__link" href="/location"<% if (path === '/location') { %> aria-current="page"<% } %>>Find us</a></li>
            <%# The same account links live here and in .header-cta; CSS shows exactly one set per breakpoint. %>
            <% if (currentUser) { %>
              <li class="nav__auth"><a class="nav__link" href="/account">My bookings</a></li>
              <% if (isAdmin) { %><li class="nav__auth"><a class="nav__link" href="/portal">Staff area</a></li><% } %>
            <% } else { %>
              <li class="nav__auth"><a class="nav__link" href="/auth/login">Sign in</a></li>
              <li class="nav__auth"><a class="nav__link" href="/auth/register">Create an account</a></li>
              <%# The staff entry point. It is a convenience, not a control: the portal
                  checks the role in the database on every request, whoever clicks this. %>
              <li class="nav__auth"><a class="nav__link" href="/auth/login?next=/portal">Staff login</a></li>
            <% } %>
          </ul>
        </nav>

        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">N</span>
          <span class="brand__text">
            <span class="brand__name">Naina <em>Beauty</em> <span class="brand__tail">Parlour</span></span>
            <span class="brand__tag">Salon Make-up Studio</span>
          </span>
        </a>

        <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="primary-nav">
          <span class="nav-toggle__label-open">Menu</span>
          <span class="nav-toggle__label-close">Close</span>
        </button>

        <div class="header-cta">
          <%# Booking lives in the hero, the nav and every service page. The header carries
              the account controls only, so one action per strip and no squeezed buttons. %>
          <% if (currentUser) { %>
            <a class="header-account" href="/account" aria-label="My account and profile" data-account-trigger>
              <% if (currentUser.photo_path) { %>
                <img class="header-account__img" src="<%= currentUser.photo_path %>" alt="" width="32" height="32">
              <% } else { %>
                <svg class="header-account__icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
                  <path d="M4.5 20c1.4-3.4 4.1-5 7.5-5s6.1 1.6 7.5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                </svg>
              <% } %>
            </a>
            <a class="btn btn--ghost btn--sm header-cta__auth" href="/account">My bookings</a>
            <% if (isAdmin) { %><a class="btn btn--primary btn--sm header-cta__auth" href="/portal">Staff area</a><% } %>
          <% } else { %>
            <a class="header-account" href="/auth/login" aria-label="Sign in or create an account">
              <svg class="header-account__icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
                <path d="M4.5 20c1.4-3.4 4.1-5 7.5-5s6.1 1.6 7.5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
              </svg>
            </a>
            <a class="btn btn--ghost btn--sm header-cta__auth" href="/auth/login">Sign in</a>
            <a class="btn btn--ghost btn--sm header-cta__auth" href="/auth/login?next=/portal">Staff</a>
          <% } %>
        </div>
      </div>
    </header>

    <% if (currentUser) { %>
      <%#
        The account pop-up. It lives outside <main> and starts closed: main.js
        fills it from /account/panel and re-opens it with showModal(), so the page
        behind never changes. The tick, the details and the two booking lists all
        come from that fragment, because completeness is decided in the database
        and not here. With JavaScript off this dialog is simply never opened and
        the header icon keeps working as the link it is.
      %>
      <dialog class="poppanel" id="account-panel" data-account-panel aria-labelledby="account-panel-title">
        <div class="poppanel__bar">
          <h2 class="poppanel__title" id="account-panel-title">My account</h2>
          <button class="popup__close" type="button" data-popup-close aria-label="Close the account panel">
            <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20">
              <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
        <div class="poppanel__body" data-account-panel-body>
          <p class="loading" data-visible="true"><span class="spinner"></span> Loading your account…</p>
        </div>
      </dialog>
    <% } %>

    <main id="main">
      <%- include('flash') %>
