<%
/* One password field with a show/hide control, shared by sign in, registration,
   the reset link and the profile page, so the label, the error and the hint
   behave identically wherever a password is typed. */
var fid = locals.id || 'password';
var err = locals.error || null;
var autocomplete = locals.autocomplete || 'new-password';
var describedBy = [locals.hint ? fid + '-hint' : null, err ? fid + '-error' : null].filter(Boolean).join(' ');
%>
<div class="field">
  <label for="<%= fid %>"><%= locals.label %></label>
  <div class="pw">
    <input class="input pw__input" id="<%= fid %>" name="<%= locals.name || fid %>" type="password"
           autocomplete="<%= autocomplete %>"
           <% if (locals.minLength) { %>minlength="<%= locals.minLength %>"<% } %>
           <% if (locals.required !== false) { %>required<% } %>
           <% if (describedBy) { %>aria-describedby="<%= describedBy %>"<% } %>
           <% if (err) { %>aria-invalid="true"<% } %>>
    <button class="pw__toggle" type="button" data-reveal="<%= fid %>" aria-controls="<%= fid %>" aria-pressed="false">
      <span data-reveal-label>Show</span><span class="sr-only"> password</span>
    </button>
  </div>
  <% if (err) { %><p class="error" id="<%= fid %>-error"><%= err %></p><% } %>
  <% if (locals.hint) { %><p class="hint" id="<%= fid %>-hint"><%= locals.hint %></p><% } %>
</div>
