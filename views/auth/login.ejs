<%- include('../partials/head') %>

<section class="section" aria-labelledby="page-title">
  <div class="wrap wrap--narrow">
    <%- include('../partials/auth-tabs', { active: 'login', next: locals.next || '' }) %>

    <div class="card card--accent">
      <p class="eyebrow">Returning client</p>
      <h1 id="page-title">Sign in to your account</h1>
      <p class="muted">
        Signing in lets you see your requests, follow the studio’s confirmation and book another time.
        New here? Use <strong>Create an account</strong> above — it takes a minute.
      </p>

      <% if (errors.form) { %><p class="alert alert--error" role="alert"><%= errors.form %></p><% } %>

      <form method="post" action="/auth/login" class="mt-2" data-once>
        <%- csrfField() %>

        <div class="field">
          <label for="email">Email address</label>
          <input class="input" id="email" name="email" type="email" inputmode="email"
                 autocomplete="email" required <% if (values.email) { %>value="<%= values.email %>"<% } %>
                 <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
          <% if (errors.email) { %><p class="error" id="email-error"><%= errors.email %></p><% } %>
        </div>

        <%- include('../partials/password-field', {
          id: 'password',
          label: 'Password',
          autocomplete: 'current-password',
          error: errors.password || null
        }) %>

        <%- include('../partials/captcha') %>

        <div class="form-actions">
          <button class="btn" type="submit">Sign in</button>
          <a class="btn btn--ghost" href="/auth/forgot-password<%= locals.next ? '?next=' + encodeURIComponent(locals.next) : '' %>">Forgot password</a>
        </div>
        <p class="form-note">
          Attempts are limited from one connection, and the human check is verified on the studio’s
          server. Your password is never stored in plain text.
        </p>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
