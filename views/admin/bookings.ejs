<%- include('../partials/head') %>

<%
  var adminTabs = [
    { href: '/admin', label: 'Today' },
    { href: '/admin/bookings?status=pending', label: 'Requests' },
    { href: '/admin/services', label: 'Services' },
    { href: '/admin/hours', label: 'Hours & settings' },
  ];
  var filters = [
    { key: 'pending', label: 'Pending' },
    { key: 'confirmed', label: 'Confirmed' },
    { key: 'rejected', label: 'Declined' },
    { key: 'cancelled', label: 'Cancelled' },
    { key: 'all', label: 'Everything' },
  ];
%>

<section class="section" aria-labelledby="page-title">
  <div class="wrap">
    <p class="eyebrow">Salon team</p>
    <h1 id="page-title">Booking requests</h1>

    <div class="tabs mt-2" role="navigation" aria-label="Staff sections">
      <% adminTabs.forEach(function (tab) { %>
        <a href="<%= tab.href %>" aria-current="<%= currentPath === tab.href.split('?')[0] ? 'true' : 'false' %>"><%= tab.label %></a>
      <% }) %>
    </div>

    <div class="tabs" role="group" aria-label="Filter by status">
      <% filters.forEach(function (filter) { %>
        <a href="/admin/bookings?status=<%= filter.key %>" aria-current="<%= status === filter.key ? 'true' : 'false' %>">
          <%= filter.label %>
          <% if (filter.key === 'pending') { %>(<%= counts.pending %>)<% } %>
          <% if (filter.key === 'confirmed') { %>(<%= counts.confirmed %>)<% } %>
          <% if (filter.key === 'all') { %>(<%= counts.pending + counts.confirmed + counts.other %>+)<% } %>
        </a>
      <% }) %>
    </div>

    <% if (!bookings.length) { %>
      <p class="empty">No <%= status === 'all' ? 'requests' : status %> bookings. Nothing to do here right now.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Booking requests with status <%= status %></caption>
          <thead>
            <tr>
              <th scope="col">#</th><th scope="col">When</th><th scope="col">Service</th>
              <th scope="col">Client</th><th scope="col">Notes</th><th scope="col">Status / decision</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(function (booking) { %>
              <tr>
                <th scope="row">#<%= booking.id %></th>
                <td class="nowrap">
                  <%= booking.dayLabel %><br><span class="small muted"><%= booking.timeLabel %></span>
                  <% if (booking.isPast) { %><span class="badge badge--muted">past</span><% } %>
                  <% if (booking.isToday) { %><span class="badge badge--rose">today</span><% } %>
                </td>
                <td><%= booking.service_name %><br><span class="small muted"><%= booking.duration_minutes %> min · <%= booking.category_name %></span></td>
                <td>
                  <strong><%= booking.contact_name %></strong><%= booking.preferred_title ? ' (' + booking.preferred_title + ')' : '' %><br>
                  <a href="tel:<%= booking.contact_phone %>"><%= booking.contact_phone || 'no number' %></a><br>
                  <span class="small muted"><%= booking.user_email %></span><br>
                  <a class="small" href="/admin/customers/<%= booking.user_id %>">client file</a>
                </td>
                <td class="small">
                  <% if (booking.note) { %><p class="mb-0">Client: <%= booking.note %></p><% } %>
                  <% if (booking.staff_note) { %><p class="mb-0">Studio: <%= booking.staff_note %></p><% } %>
                  <% if (!booking.note && !booking.staff_note) { %>—<% } %>
                </td>
                <td>
                  <span class="pill pill--<%= booking.status %>"><%= booking.status %></span>
                  <form method="post" action="/admin/bookings/<%= booking.id %>/status" class="mt-1">
                    <%- csrfField() %>
                    <input type="hidden" name="back" value="/admin/bookings?status=<%= status %>">
                    <label class="sr-only" for="note-<%= booking.id %>">Studio note for #<%= booking.id %></label>
                    <input class="input" id="note-<%= booking.id %>" name="staff_note" type="text" maxlength="200"
                           placeholder="Note (optional)">
                    <button class="btn btn--sm btn--primary" type="submit" name="status" value="confirmed">Confirm</button>
                    <button class="btn btn--sm btn--danger" type="submit" name="status" value="rejected">Decline</button>
                    <% if (booking.status === 'confirmed') { %>
                      <button class="btn btn--sm btn--ghost" type="submit" name="status" value="cancelled">Cancel</button>
                    <% } %>
                    <% if (booking.status !== 'pending') { %>
                      <button class="btn btn--sm btn--ghost" type="submit" name="status" value="pending">Reopen</button>
                    <% } %>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="hint mt-1">
        Reopening a request puts the hold back on the slot. If another client has since taken that time,
        the database refuses it and you will see the reason.
      </p>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
