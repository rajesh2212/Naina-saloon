<%- include('../partials/head') %>

<%
  var adminTabs = [
    { href: '/admin', label: 'Today' },
    { href: '/admin/bookings', label: 'Requests' },
    { href: '/admin/services', label: 'Services' },
    { href: '/admin/hours', label: 'Hours & settings' },
  ];
%>

<section class="section" aria-labelledby="page-title">
  <div class="wrap">
    <p class="eyebrow">Salon team</p>
    <h1 id="page-title">Hours and booking settings</h1>
    <p class="lede">
      The diary only offers times inside these hours. The studio opened at 9:00 am and these rows were
      seeded as a starting configuration — please set the real closing time for each day, then close any
      day the parlour does not sit.
    </p>

    <div class="tabs mt-2" role="navigation" aria-label="Staff sections">
      <% adminTabs.forEach(function (tab) { %>
        <a href="<%= tab.href %>" aria-current="<%= currentPath === tab.href ? 'true' : 'false' %>"><%= tab.label %></a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section--panel" aria-labelledby="week-title">
  <div class="wrap">
    <h2 id="week-title">Weekly hours</h2>
    <div class="grid grid--2">
      <% week.forEach(function (day) { %>
        <form class="card card--flat" method="post" action="/admin/hours">
          <%- csrfField() %>
          <input type="hidden" name="weekday" value="<%= day.weekday %>">
          <h3 class="card__title"><%= day.label %></h3>

          <div class="grid grid--2">
            <div class="field">
              <label for="open-<%= day.weekday %>">Opens</label>
              <input class="input" id="open-<%= day.weekday %>" name="opens_at" type="time"
                     value="<%= day.opens_at %>" required>
            </div>
            <div class="field">
              <label for="close-<%= day.weekday %>">Last slot starts before</label>
              <input class="input" id="close-<%= day.weekday %>" name="closes_at" type="time"
                     value="<%= day.closes_at %>" required>
            </div>
          </div>

          <div class="field">
            <div class="checkline">
              <input type="checkbox" id="closed-<%= day.weekday %>" name="is_closed" value="1"
                     <%= day.is_closed ? 'checked' : '' %>>
              <label for="closed-<%= day.weekday %>">Closed all day — nothing bookable</label>
            </div>
          </div>

          <div class="field">
            <label for="note-<%= day.weekday %>">Note <span class="optional">(optional, staff only)</span></label>
            <input class="input" id="note-<%= day.weekday %>" name="note" type="text" maxlength="120"
                   value="<%= day.note || '' %>" placeholder="e.g. Closes 1 pm on Wednesdays">
          </div>

          <div class="form-actions">
            <button class="btn btn--sm btn--primary" type="submit">Save <%= day.label %></button>
          </div>
        </form>
      <% }) %>
    </div>
    <p class="hint mt-2">
      Times are 24-hour on the studio’s clock (Asia/Kolkata). A service is only offered where its full
      chair time fits before the closing minute.
    </p>
  </div>
</section>

<section class="section" aria-labelledby="settings-title">
  <div class="wrap grid grid--2">
    <div>
      <h2 id="settings-title">Booking rules</h2>
      <form method="post" action="/admin/settings" class="card card--flat">
        <%- csrfField() %>
        <% settings.forEach(function (item) { %>
          <div class="field">
            <label for="<%= item.key %>"><%= item.label %></label>
            <input class="input" id="<%= item.key %>" name="<%= item.key %>" type="number" min="1" step="1"
                   value="<%= item.value %>" aria-describedby="<%= item.key %>-hint">
            <p class="hint" id="<%= item.key %>-hint"><%= item.hint %></p>
          </div>
        <% }) %>
        <div class="form-actions">
          <button class="btn" type="submit">Save settings</button>
        </div>
      </form>
    </div>

    <div class="card card--accent">
      <h2 class="card__title">Integration status</h2>
      <%
        var allPhotos = Object.values(site.photos).flat();
        var filled = allPhotos.filter(function (p) { return p.present });
        var missing = allPhotos.filter(function (p) { return !p.present });
      %>
      <dl class="summary">
        <dt>CAPTCHA</dt><dd><%= site.captcha.label %></dd>
        <dt>Email delivery</dt><dd><%= site.mail.enabled ? 'SMTP configured' : 'Not configured' %></dd>
        <dt>Photographs</dt><dd><%= filled.length %> of <%= allPhotos.length %> slots hold a real photo</dd>
        <dt>Online payment</dt><dd>Not built (by design)</dd>
      </dl>
      <p class="hint mt-1"><%= site.captcha.note %></p>
      <% if (!site.mail.enabled) { %>
        <p class="alert alert--error mt-1">
          <strong>Password reset links cannot be sent.</strong> Fill in the SMTP variables in
          <code>.env</code>, or the forgot-password page tells visitors to call the studio instead.
        </p>
      <% } %>
      <% if (missing.length) { %>
        <p class="alert alert--info mt-1">
          <strong><%= missing.length %> photograph<%= missing.length === 1 ? '' : 's' %> still to shoot.</strong>
          Until a real file exists each slot shows a generated picture tagged
          <em>Illustrative</em> in the corner. Save the studio’s own photograph in
          <code>public/assets/</code> using exactly this name and it takes over on the next page load:
        </p>
        <ul class="feature-list mt-1">
          <% missing.forEach(function (p) { %>
            <li><code><%= p.file %></code></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
