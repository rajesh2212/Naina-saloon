<%- include('../partials/head') %>

<%
  var adminTabs = [
    { href: '/admin', label: 'Today' },
    { href: '/admin/bookings', label: 'Requests' },
    { href: '/admin/services', label: 'Services' },
    { href: '/admin/hours', label: 'Hours & settings' },
  ];
%>

<section class="section" aria-labelledby="page-title">
  <div class="wrap">
    <p class="eyebrow">Salon team</p>
    <h1 id="page-title">Service list</h1>
    <p class="lede">
      Chair time decides which slots a service can occupy, so keep it realistic. Price text is optional —
      leave it blank and the public page says “At the studio”.
    </p>

    <div class="tabs mt-2" role="navigation" aria-label="Staff sections">
      <% adminTabs.forEach(function (tab) { %>
        <a href="<%= tab.href %>" aria-current="<%= currentPath === tab.href ? 'true' : 'false' %>"><%= tab.label %></a>
      <% }) %>
    </div>

    <% categories.forEach(function (category) { %>
      <section class="mt-3" aria-labelledby="<%= category.slug %>-admin">
        <div class="flex flex--between">
          <h2 id="<%= category.slug %>-admin"><%= category.name %></h2>
          <form method="post" action="/admin/categories/<%= category.id %>/toggle">
            <%- csrfField() %>
            <button class="btn btn--sm btn--ghost" type="submit"><%= category.is_active ? 'Hide group' : 'Show group' %></button>
          </form>
        </div>
        <p class="small muted"><%= category.summary %></p>

        <% if (!category.services.length) { %>
          <p class="empty">No services in this group yet.</p>
        <% } %>

        <div class="grid grid--2">
          <% category.services.forEach(function (service) { %>
            <article class="card <%= service.is_active ? '' : 'card--flat' %>">
              <div class="flex flex--between">
                <h3 class="card__title mb-0"><%= service.name %></h3>
                <span class="badge <%= service.is_active ? '' : 'badge--muted' %>"><%= service.is_active ? 'listed' : 'hidden' %></span>
              </div>

              <form method="post" action="/admin/services/<%= service.id %>" class="mt-1">
                <%- csrfField() %>

                <div class="field">
                  <label for="name-<%= service.id %>">Name</label>
                  <input class="input" id="name-<%= service.id %>" name="name" type="text" maxlength="80"
                         value="<%= service.name %>" required>
                </div>

                <div class="field">
                  <label for="desc-<%= service.id %>">Description</label>
                  <textarea class="textarea textarea--short" id="desc-<%= service.id %>" name="description"
                            rows="3" maxlength="400"><%= service.description || '' %></textarea>
                  <p class="hint">Keep it factual — what the service is, not what it promises to fix.</p>
                </div>

                <div class="grid grid--2">
                  <div class="field">
                    <label for="dur-<%= service.id %>">Chair time (minutes)</label>
                    <input class="input" id="dur-<%= service.id %>" name="duration_minutes" type="number"
                           min="15" max="480" step="5" value="<%= service.duration_minutes %>" required>
                  </div>
                  <div class="field">
                    <label for="price-<%= service.id %>">Price text <span class="optional">(optional)</span></label>
                    <input class="input" id="price-<%= service.id %>" name="price_text" type="text" maxlength="60"
                           value="<%= service.price_text || '' %>" placeholder="Blank = “At the studio”">
                  </div>
                </div>

                <div class="field">
                  <div class="checkline">
                    <input type="checkbox" id="book-<%= service.id %>" name="is_bookable" value="1"
                           <%= service.is_bookable ? 'checked' : '' %>>
                    <label for="book-<%= service.id %>">Bookable online (shows in the booking picker)</label>
                  </div>
                </div>

                <div class="form-actions">
                  <button class="btn btn--sm btn--primary" type="submit">Save changes</button>
                </div>
              </form>

              <form method="post" action="/admin/services/<%= service.id %>/toggle">
                <%- csrfField() %>
                <button class="btn btn--sm btn--ghost" type="submit">
                  <%= service.is_active ? 'Hide from website' : 'List on website' %>
                </button>
              </form>
            </article>
          <% }) %>
        </div>
      </section>
    <% }) %>

    <p class="hint mt-3">
      Settings in force: slots every <%= rules.stepMinutes %> min, bookable <%= rules.horizonDays %> days ahead,
      <%= rules.leadMinutes %> min same-day notice, <%= rules.maxActivePerUser %> open bookings per account.
      Changing these affects future availability only — existing bookings keep their slots.
    </p>
  </div>
</section>

<%- include('../partials/footer') %>
