# Runtime data (SQLite database, mail outbox)
/data/
*.sqlite
*.db
*.db-wal
*.db-shm

# Booking PDF tickets and customer avatars. Outside public/ on purpose — the
# static mount serves public/ to anyone who asks, and a ticket is named
# `booking-<id>.pdf`. These are real faces, names and phone numbers tied to real
# accounts, so they stay on the server that took them.
/uploads/
# Kept so an old checkout can never put customer files back where the static
# mount would serve them.
/public/uploads/

# Local secrets
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

.vercel
.env*
